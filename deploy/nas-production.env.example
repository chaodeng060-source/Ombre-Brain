# Copy to a mode-0600 file outside the repository before use.
# This file contains no authentication secrets; OMBRE_SECRET_ENV_FILE points
# to the existing protected runtime environment.

OMBRE_CONTAINER_NAME=ombre-vps-mirror
OMBRE_SERVICE=ombre-brain
OMBRE_HOST_PORT=8001
OMBRE_HEALTH_URL=http://127.0.0.1:8001/health
OMBRE_NETWORK_MODE=ombre-net

OMBRE_ACTIVE_DIR=/vol1/ombre-migrate/code
OMBRE_DATA_DIR=/vol1/ombre-migrate/data
OMBRE_SNAPSHOT_DIR=/vol1/ombre-migrate/snapshots
OMBRE_CONFIG_FILE=/vol1/ombre-migrate/code/config.yaml
OMBRE_SECRET_ENV_FILE=/vol1/ombre-migrate/mirror.env
OMBRE_BACKUP_ROOT=/home/zhaodeng/ombre-backups/ombre-vps-mirror
OMBRE_DEPLOYMENT_ANCHOR_FILE=/vol1/ombre-migrate/deployment-anchor.env
OMBRE_MUTATION_LOCK_FILE=/vol1/ombre-migrate/ombre-production.lock

# Preserve the existing anonymous /app/buckets volume during the first
# migration; replace this audited ID only after an explicit volume migration.
OMBRE_BUCKETS_VOLUME=94f83ac9504f8b4a046e0e06a6ed6cf18e877d1bc32ac845ec9bb3d3ae4b14cb
OMBRE_BUCKETS_VOLUME_EXTERNAL=true

# Deploys always use an exact commit tag.  The deploy script replaces these
# values from its --commit argument and never pulls or selects latest.
OMBRE_IMAGE_REPOSITORY=ombre-vps-mirror
OMBRE_IMAGE_TAG=REPLACE_WITH_40_HEX_COMMIT
OMBRE_DEPLOY_COMMIT=REPLACE_WITH_40_HEX_COMMIT

# Current read-only first-cutover anchors (2026-08-31).  The deploy script
# verifies these values, then atomically writes the new IDs to
# OMBRE_DEPLOYMENT_ANCHOR_FILE.  Backup and later deploy runs load that file
# last, so cron never keeps using stale pre-rebuild IDs.
OMBRE_EXPECTED_CONTAINER_ID=fe474dc8b3347c6fbfc70bb6dc781d32f53b8c68a9cbc4a745146c996283d711
OMBRE_EXPECTED_IMAGE_ID=sha256:2629696526f287a6c2268addb8e101c2ebbbfa3a2de2636ce2761befc9b45255

OMBRE_BACKUP_KEEP=7
OMBRE_HEALTH_WAIT_SECONDS=180
OMBRE_JOB_ENV_FILE=/vol1/ombre-migrate/nas-production.env
OMBRE_JOB_REPO_DIR=/vol1/ombre-migrate/code

# The audited NAS cron daemon loads /etc/cron.d, which is root-owned.  Run the
# installer as root in the authorized cutover window; the scheduled commands
# themselves continue to run as zhaodeng and read this mode-0600 environment.
OMBRE_JOB_CRON_FILE=/etc/cron.d/ombre-vps-mirror
OMBRE_JOB_CRON_USER=zhaodeng
OMBRE_PUBLIC_HEALTH_URL=https://memory.zhaodeng.xyz/health
