{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run_lmc5_hook.mjs",
              "session-breath"
            ],
            "timeout": 12,
            "statusMessage": "Ombre Brain 正在浮现记忆..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run_lmc5_hook.mjs",
              "retry-outbox"
            ],
            "timeout": 12,
            "statusMessage": "Ombre Brain 正在补送待归档事件..."
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run_lmc5_hook.mjs",
              "session-breath"
            ],
            "timeout": 12,
            "statusMessage": "Ombre Brain 正在浮现记忆..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run_lmc5_hook.mjs",
              "retry-outbox"
            ],
            "timeout": 12,
            "statusMessage": "Ombre Brain 正在补送待归档事件..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run_lmc5_hook.mjs",
              "user-prompt-submit"
            ],
            "timeout": 15,
            "statusMessage": "Ombre Brain 正在按需召回..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run_lmc5_hook.mjs",
              "session-end"
            ],
            "timeout": 60,
            "statusMessage": "Ombre Brain 正在归档本轮原始事件..."
          }
        ]
      }
    ]
  }
}
